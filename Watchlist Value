                  <div>
                    <div className="flex items-center gap-2">
                      <span className="f-disp" style={{ fontSize: "1.18rem", fontWeight: 600 }}>{row.nom}</span>
                      {row.foss && (
                        <span className="f-mono text-[9px] px-1.5 py-0.5 rounded"
                              style={{ color: C.red, border: `1px solid ${C.red}` }}>⛔ FOSSILE</span>
                      )}
                      {row.opa && (
                        <span className="f-mono text-[9px] px-1.5 py-0.5 rounded"
                              style={{ color: "#a78bfa", border: "1px solid #a78bfa" }}>🔒 OPA EN COURS</span>
                      )}
                    </div>
                    <div className="f-mono text-[11px] mt-0.5 flex items-center gap-1.5" style={{ color: C.dim }}>
                      {row.bucket && row.bucket !== "—" && (
                        <span className="f-mono text-[9px] px-1.5 py-0.5 rounded font-bold"
                              style={{
                                color: BUCKET_COLOR[row.bucket] || C.dim,
                                border: `1px solid ${BUCKET_COLOR[row.bucket] || C.line}`,
                              }}
                              title={BUCKET_LABEL[row.bucket] || ""}>
                          {row.bucket}
                        </span>
                      )}
                      <span>{row.tk} · {row.sec}</span>
                    </div>
                  </div>
                  <div className="text-right">
                    {row.opa ? (
                      <span className="f-mono text-[10px] px-2 py-1 rounded inline-block"
                            style={{ color: "#a78bfa", border: "1px solid #a78bfa" }}>
                        🔒 OFFRE 15,60 € · juil. 2026
                      </span>
                    ) : (
                      <span className="f-mono text-[10px] px-2 py-1 rounded inline-block"
                            style={{
                              color: c.buy ? C.ink : C.wait,
                              background: c.buy ? C.buy : "transparent",
                              border: c.buy ? "none" : `1px solid ${C.wait}`,
                            }}>
                        {c.cible === null ? "—" : c.buy ? "✓ ACHETER" : `ATTENDRE −${fmt(c.ecart, 0)}%`}
                      </span>
                    )}
                  </div>
                </div>

                {/* Cours vs cible */}
                <div className="grid grid-cols-3 gap-px mx-4 mb-3 rounded overflow-hidden" style={{ background: C.line }}>
                  <Cell label="Cours" val={fmt(c.cours) + " €"} sub={row.flag ? "⚠ à vérifier" : ""} C={C} />
                  <Cell label="Valeur intrinsèque" val={c.unstable ? "⚠ instable" : (c.vi === null ? "—" : fmt(c.vi) + " €")} sub={c.unstable ? "r−g < 2 pts" : ""} C={C} />
                  <Cell label="Prix-cible d'achat" val={c.unstable ? "⚠ n/a" : (c.cible === null ? "—" : fmt(c.cible) + " €")} sub={c.unstable ? "modèle DCF non fiable ici" : (c.cible !== null ? `MoS ${fmt(c.marge, 0)}%${row.margeOverride !== undefined && row.margeOverride !== null && row.margeOverride !== "" ? " (override)" : ""}` : "")} accent C={C} />
                </div>

                {/* Champs éditables */}
                <div className="px-4 pb-3 grid gap-2"
                     style={{ gridTemplateColumns: s.method === "dcf" ? "1fr 1fr 1fr 1fr 1fr" : "1fr 1fr 1fr 1fr" }}>
                  <Field label="Cours €" v={row.cours} onChange={(v) => setRow(row.id, "cours", v)} cls={inputCls} st={inputStyle} C={C} />
                  <Field label="BPA norm. €" v={row.bpa} onChange={(v) => setRow(row.id, "bpa", v)} cls={inputCls} st={inputStyle} C={C} />
                  {s.method === "multiple"
                    ? <Field label="Juste PER" v={row.jper} onChange={(v) => setRow(row.id, "jper", v)} cls={inputCls} st={inputStyle} C={C} />
                    : <Field label="Croissance g %" v={row.g} onChange={(v) => setRow(row.id, "g", v)} cls={inputCls} st={inputStyle} C={C} />}
                  {s.method === "dcf" &&
                    <Field label="Juste PER" v={row.jper} onChange={(v) => setRow(row.id, "jper", v)} cls={inputCls} st={inputStyle} C={C} />}
                  <Field label="MoS override %" v={row.margeOverride ?? ""} onChange={(v) => setRow(row.id, "margeOverride", v)} cls={inputCls} st={inputStyle} C={C} placeholder="auto" />
                </div>

                {/* PER actuel + note */}
                <div className="px-4 pb-3.5 flex items-start justify-between gap-3">
                  <p className="text-[12.5px] italic flex-1" style={{ color: C.dim }}>{row.note}</p>
                  <div className="text-right shrink-0">
                    <div className="f-mono text-[10px] uppercase" style={{ color: C.dim, letterSpacing: "0.1em" }}>PER actuel</div>
                    <div className="f-mono text-sm" style={{ color: c.per && c.per > row.jper ? C.wait : C.buy }}>
                      {c.per === null ? "—" : fmt(c.per, 1) + "x"}
                    </div>
                  </div>
                  <button onClick={() => delRow(row.id)} className="f-mono text-[11px] self-center"
                          style={{ color: C.brassDim }} title="Retirer">✕</button>
                </div>
              </div>
            );
          })}
        </div>

        {/* Actions */}
        <div className="mt-6 space-y-3">
          {/* Bouton actualisation */}
          <div className="rounded-lg px-4 py-3 flex items-center justify-between gap-3"
               style={{ background: C.panel, border: `1px solid ${C.line}` }}>
            <div className="flex-1 min-w-0">
              <div className="f-mono text-[10px] uppercase mb-0.5" style={{ color: C.dim, letterSpacing: "0.12em" }}>
                Cours en temps réel
              </div>
              <div className="f-mono text-[11px] truncate" style={{ color: refreshStatus.startsWith("✓") ? C.buy : refreshStatus.startsWith("⚠") ? C.wait : C.dim }}>
                {refreshStatus || "Appuie pour récupérer les cours actuels via l'API"}
              </div>
            </div>
            <button
              onClick={refreshPrices}
              disabled={refreshing || !loaded}
              className="f-mono text-xs px-4 py-2 rounded shrink-0"
              style={{
                background: refreshing ? C.line : C.brass,
                color: refreshing ? C.dim : C.ink,
                opacity: refreshing ? 0.6 : 1,
                cursor: refreshing ? "not-allowed" : "pointer",
              }}>
              {refreshing ? "⏳ En cours…" : "⟳ Actualiser"}
            </button>
          </div>

          <div className="flex items-center justify-between">
            <button onClick={() =>
              setS((p) => ({ ...p, rows: [...p.rows, { id: Date.now(), nom: "Nouvelle ligne", tk: "—", sec: "—", foss: false, cours: 0, bpa: 0, jper: 15, g: 5, flag: true, note: "À compléter." }] }))}
              className="f-mono text-xs px-3 py-2 rounded"
              style={{ color: C.brass, border: `1px solid ${C.brassDim}` }}>
              + Ajouter une valeur
            </button>
            <button onClick={reset} className="f-mono text-xs px-3 py-2 rounded" style={{ color: C.dim }}>
              Réinitialiser
            </button>
          </div>
        </div>

        <p className="mt-6 text-[11px] leading-relaxed" style={{ color: C.brassDim }}>
          Outil personnel d'aide à la décision — pas un conseil en investissement. Le « Juste PER », la croissance,
          le rendement exigé et la marge de sécurité sont <em>tes</em> hypothèses : c'est là que se joue toute la prudence.
          Un cours bon marché sur une qualité qui s'érode (ROE/marges en baisse) reste un piège, pas une affaire.
          Tes saisies sont enregistrées automatiquement.
        </p>
      </div>
    </div>
  );
}

function Cell({ label, val, sub, accent, C }) {
  return (
    <div className="px-3 py-2.5" style={{ background: C.panel2 }}>
      <div className="f-mono text-[9px] uppercase mb-1" style={{ color: C.dim, letterSpacing: "0.12em" }}>{label}</div>
      <div className="f-mono text-[15px]" style={{ color: accent ? C.brass : C.text }}>{val}</div>
      {sub ? <div className="f-mono text-[9px] mt-0.5" style={{ color: C.wait }}>{sub}</div> : null}
    </div>
  );
}

function Field({ label, v, onChange, cls, st, C, placeholder }) {
  return (
    <label className="block">
      <span className="f-mono text-[9px] uppercase block mb-1" style={{ color: C.dim, letterSpacing: "0.1em" }}>{label}</span>
      <input type="number" step="any" value={v} placeholder={placeholder}
             onChange={(e) => onChange(e.target.value === "" ? "" : +e.target.value)}
             className={cls} style={st} />
    </label>
  );
}
