const KEY = "watchlist-value-v1";

const fmt = (n, d = 2) =>
  (n === null || n === undefined || !isFinite(n))
    ? "—"
    : Number(n).toLocaleString("fr-FR", { minimumFractionDigits: d, maximumFractionDigits: d });

function getMarge(row, s) {
  if (row.margeOverride !== undefined && row.margeOverride !== null && row.margeOverride !== "") {
    return +row.margeOverride;
  }
  if (row.bucket && s.margeByBucket && s.margeByBucket[row.bucket] !== undefined) {
    return s.margeByBucket[row.bucket];
  }
  return s.margeDefault ?? 30;
}

function compute(row, s) {
  const cours = +row.cours || 0;
  const bpa = +row.bpa || 0;
  const per = bpa > 0 ? cours / bpa : null;
  let vi = null;
  let unstable = false;
  if (s.method === "multiple") {
    vi = bpa > 0 ? bpa * (+row.jper || 0) : null;
  } else {
    const g = (+row.g || 0) / 100;
    const r = (+s.r || 0) / 100;
    const spread = r - g;
    if (bpa > 0 && spread >= 0.02) {
      // Gordon Growth n'est fiable qu'avec une marge r−g suffisante (≥2 pts) ;
      // en dessous, le dénominateur proche de 0 fait exploser la valeur (artefact, pas un signal réel).
      vi = (bpa * (1 + g)) / spread;
    } else {
      unstable = bpa > 0 && spread < 0.02 && spread > 0;
    }
  }
  const marge = getMarge(row, s);
  const cible = vi !== null ? vi * (1 - marge / 100) : null;
  const buy = cible !== null && cours > 0 ? cours <= cible : false;
  const ecart = cible !== null && cours > 0 ? ((cours - cible) / cours) * 100 : null; // % de baisse nécessaire
  return { cours, bpa, per, vi, cible, buy, ecart, marge, unstable };
}

